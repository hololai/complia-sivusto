{
  "name": "tietosuojapalvelut-sivusto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port 4321",
    "tarkista": "npm run build && node scripts/tarkista.mjs",
    "tarkista:julkaisu": "npm run build && node scripts/tarkista.mjs --julkaisu"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "astro": "7.4.2"
  }
}
