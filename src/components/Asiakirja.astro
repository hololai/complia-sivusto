---
import Teksti from './Teksti.astro';
import { kirjain, osionNumero, type Asiakirja } from '../data/asiakirja';

// Näyttää asiakirjan paperiarkkina. Samaa dataa käyttää Word-tiedoston rakentaja.
interface Props {
  asiakirja: Asiakirja;
  id: string;
}
const { asiakirja, id } = Astro.props;
---

<article class="arkki" id={id} aria-labelledby={`${id}-otsikko`}>
  <header class="arkki__yla">
    <h2 id={`${id}-otsikko`}><Teksti teksti={asiakirja.otsikko} /></h2>
    {asiakirja.alaotsikko && <p class="arkki__paivays"><Teksti teksti={asiakirja.alaotsikko} /></p>}
  </header>
  {
    asiakirja.osiot.map((osio, i) => (
      <section class="arkki__osio">
        <span class="arkki__numero" aria-hidden="true">
          {osionNumero(osio, i)}
        </span>
        <div>
          <h3>
            {!osio.tunnus && <span class="visually-hidden">{i + 1}. </span>}
            {osio.otsikko}
          </h3>
          {osio.osat.map((osa) => {
            if (osa.tyyppi === 'kappale')
              return (
                <p>
                  <Teksti teksti={osa.teksti} />
                </p>
              );
            if (osa.tyyppi === 'rivit')
              return (
                <p>
                  {osa.rivit.map((r, j) => (
                    <>
                      {j > 0 && <br />}
                      <Teksti teksti={r} />
                    </>
                  ))}
                </p>
              );
            if (osa.tyyppi === 'lista')
              return (
                <ul>
                  {osa.kohdat.map((k) => (
                    <li>
                      <Teksti teksti={k} />
                    </li>
                  ))}
                </ul>
              );
            if (osa.tyyppi === 'taulukko')
              return (
                <div class="taulu">
                  <table class="taulukko">
                    <thead>
                      <tr>
                        {osa.otsikot.map((o) => (
                          <th scope="col">{o}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {osa.rivit.map((r) => (
                        <tr>
                          {r.map((solu) => (
                            <td>
                              <Teksti teksti={solu} />
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            if (osa.tyyppi === 'vaihtoehdot')
              return (
                <div class="vaihtoehdot">
                  {osa.vaihtoehdot.map((v, j) => (
                    <p class="vaihtoehto">
                      <span class="vaihtoehto__nimi">Vaihtoehto {kirjain(j)}</span>
                      <Teksti teksti={v} />
                    </p>
                  ))}
                </div>
              );
            return (
              <p class="arkki__ohje">
                <strong>Ohje:</strong> {osa.teksti}
              </p>
            );
          })}
        </div>
      </section>
    ))
  }
</article>
