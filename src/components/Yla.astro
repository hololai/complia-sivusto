---
import { SIVUSTO } from '../../site.config.mjs';
import { sivunPolku } from '../data/polku';

// Päävalikko on lyhyt, jotta ainoa painike erottuu: lukija valitsee ensin, onko yritys vai kunta.
// Pikatesti ja pohja ovat ohjeita, ja Meistä löytyy alatunnisteesta ja etusivulta.
const KOHDAT = [
  { nimi: 'Yrityksille', polku: '/palvelut', myos: [] as string[] },
  { nimi: 'Kunnille', polku: '/kunnat', myos: [] },
  { nimi: 'Hinnat', polku: '/hinnasto', myos: [] },
  { nimi: 'Ohjeet', polku: '/artikkelit', myos: ['/pikatesti', '/tietosuojaselostepohja'] },
];
const nyt = sivunPolku(Astro.url);
const onNyt = (polku: string, myos: string[] = []) =>
  [polku, ...myos].some((p) => nyt === p || nyt.startsWith(`${p}/`));
---

<header class="yla">
  <div class="kehys yla__sisus">
    <a class="merkki" href="/" aria-label={`${SIVUSTO.nimi}, etusivu`}>
      <svg class="merkki__kuva" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="#17453a"></rect>
        <path d="M9 16.5l4.6 4.6L23 11.5" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>
        <span class="merkki__nimi">{SIVUSTO.nimi}</span>
        <span class="merkki__slogan">{SIVUSTO.slogan}</span>
      </span>
    </a>

    <nav class="valikko" aria-label="Päävalikko">
      <ul>
        {
          KOHDAT.map((k) => (
            <li>
              <a href={k.polku} aria-current={onNyt(k.polku, k.myos) ? 'page' : undefined}>
                {k.nimi}
              </a>
            </li>
          ))
        }
        <li><a class="painike painike--pieni" href="/yhteystiedot">Ota yhteyttä</a></li>
      </ul>
    </nav>

    <!-- Toimii ilman JavaScriptiä, joten valikko ei tarvitse poikkeusta tiukkaan CSP:hen. -->
    <details class="mobiili">
      <summary>Valikko</summary>
      <nav aria-label="Päävalikko, mobiili">
        <ul>
          {
            KOHDAT.map((k) => (
              <li>
                <a href={k.polku} aria-current={onNyt(k.polku, k.myos) ? 'page' : undefined}>
                  {k.nimi}
                </a>
              </li>
            ))
          }
          <li><a href="/yhteystiedot" aria-current={onNyt('/yhteystiedot') ? 'page' : undefined}>Ota yhteyttä</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
