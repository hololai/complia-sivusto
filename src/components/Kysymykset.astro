---
// Kysymykset ovat avattavia, jotta lukija näkee kaikki kysymykset kerralla eikä joudu lukemaan vastauksia,
// joita ei tarvitse. <details> toimii ilman JavaScriptiä, ja hakukone näkee myös suljetun sisällön.
interface Props {
  kysymykset: { k: string; v: string }[];
  otsikko?: string;
}
const { kysymykset, otsikko = 'Usein kysytyt' } = Astro.props;
---

<h2>{otsikko}</h2>
<div class="kysymykset">
  {
    kysymykset.map((q) => (
      <details class="ukk">
        <summary>
          <h3>{q.k}</h3>
        </summary>
        <p>{q.v}</p>
      </details>
    ))
  }
</div>
