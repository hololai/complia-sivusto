---
interface Props {
  otsikko?: string;
  teksti?: string;
  nappi?: string;
  linkki?: string;
}
const {
  otsikko = 'Kerro tilanteesi, niin kerromme hinnan',
  teksti = 'Lähetä lyhyt viesti. Vastaamme, mitä tarvitsette ja mitä se maksaa kiinteällä hinnalla.',
  nappi = 'Ota yhteyttä',
  linkki = '/yhteydenotto',
} = Astro.props;
---

<section class="osio osio--tumma loppukehotus">
  <div class="kehys">
    <h2>{otsikko}</h2>
    <p>{teksti}</p>
    <div class="painikkeet">
      <a class="painike painike--vaalea" href={linkki}>{nappi}</a>
    </div>
  </div>
</section>
