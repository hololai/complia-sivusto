---
import { SIVUSTO } from '../../site.config.mjs';

interface Props {
  otsikko?: string;
  teksti?: string;
  nappi?: string;
  linkki?: string;
}
const {
  otsikko = 'Hoidetaan tietosuoja kuntoon yhdessä',
  teksti = 'Kertokaa lyhyesti tilanteenne. Kerromme, mitä tarvitsette, ja vahvistamme kiinteän hinnan kirjallisena.',
  nappi = 'Ota yhteyttä',
  linkki = '/yhteystiedot',
} = Astro.props;
---

<section class="osio osio--tumma loppukehotus">
  <div class="kehys">
    <h2>{otsikko}</h2>
    <p>{teksti}</p>
    <div class="painikkeet">
      <a class="painike painike--vaalea" href={linkki}>{nappi}</a>
    </div>
    <p class="loppukehotus__yhteys">
      <a href={`mailto:${SIVUSTO.sahkoposti}`}>{SIVUSTO.sahkoposti}</a>
    </p>
  </div>
</section>
