---
import { palat } from '../data/asiakirja';
import Tayta from './Tayta.astro';

// Näyttää asiakirjan tekstin niin, että asiakkaan täytettävät [kentät] erottuvat ja meidän
// täydennettävät <<kohdat>> näkyvät Täydennä-merkintöinä, jotka julkaisutarkistus estää.
interface Props {
  teksti: string;
}
const { teksti } = Astro.props;
---

{
  palat(teksti).map((p) =>
    p.tyyppi === 'kentta' ? (
      // Sitova yhdysmerkki pitää kentän kuten [Y-tunnus] yhtenä kokonaisuutena.
      <span class="kentta">{p.teksti.replace(/-/g, '‑')}</span>
    ) : p.tyyppi === 'tayta' ? (
      <Tayta>{p.teksti}</Tayta>
    ) : (
      p.teksti
    ),
  )
}
