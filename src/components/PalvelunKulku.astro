---
// Palvelun kulku asiakkaan näkökulmasta. Sisältö tulee tiedostosta src/data/kulut.ts, jotta kaikki
// palvelusivut näyttävät saman rakenteen: vaiheet, asiakkaan ja Complian osuus sekä lopputulos.
import Ikoni from './Ikoni.astro';
import Tayta from './Tayta.astro';
import { svg } from '../data/kuvat';
import type { Kulku } from '../data/kulut';

interface Props {
  kulku: Kulku;
  // Palvelun tunnus tilauslomakkeelle, esimerkiksi tietosuojaseloste.
  palvelu: string;
  nappi: string;
}
const { kulku, palvelu, nappi } = Astro.props;
---

<section class="osio osio--tumma kulku" id="nain-se-etenee" aria-labelledby="kulku-otsikko">
  <div class="kehys">
    <div class="kulku__alku">
      <p class="kulku__nostin">Avaimet käteen</p>
      <h2 id="kulku-otsikko">{kulku.otsikko}</h2>
      <p class="kulku__johdatus">{kulku.johdanto}</p>
    </div>

    <dl class="kulku__luvut">
      {
        kulku.luvut.map((l) => (
          <div>
            <span class="kulku__luku-ikoni">
              <Ikoni nimi={l.ikoni} />
            </span>
            <dt>{l.nimi}</dt>
            <dd>{l.arvo ?? <Tayta>arvo</Tayta>}</dd>
          </div>
        ))
      }
    </dl>

    <ol class="kulku__vaiheet">
      {
        kulku.vaiheet.map((v, i) => (
          <li class="kulku__vaihe">
            <div class="kulku__kuva" set:html={svg(v.kuva)} />
            <div class="kulku__teksti">
              <span class="kulku__nro" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>
                <span class="visually-hidden">Vaihe {i + 1}: </span>
                {v.otsikko}
              </h3>
              <p class="kulku__kuvaus">{v.kuvaus}</p>
              <div class="kulku__rivi kulku__rivi--te">
                <span class="kulku__tunnus">Teidän osuutenne</span>
                {v.te.merkki ? (
                  <span class="kulku__aika kulku__aika--vapaa">{v.te.merkki}</span>
                ) : (
                  v.te.aika !== undefined && (
                    <span class="kulku__aika">
                      <Ikoni nimi="kello" />
                      {v.te.aika ?? <Tayta>aika</Tayta>}
                    </span>
                  )
                )}
                <p>{v.te.teksti}</p>
              </div>
              <div class="kulku__rivi kulku__rivi--me">
                <span class="kulku__tunnus">Complia hoitaa</span>
                <p>{v.complia}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="kulku__paketti">
      <div class="kulku__paketti-kuva" set:html={svg('paketti', '0 0 220 180')} />
      <div>
        <p class="kulku__nostin kulku__nostin--tumma">Lopputulos</p>
        <h3>{kulku.paketti.otsikko}</h3>
        <p>{kulku.paketti.teksti}</p>
        <ul>
          {
            kulku.paketti.rivit.map((rivi) => (
              <li>
                <Ikoni nimi="tarkistus" />
                {rivi}
              </li>
            ))
          }
        </ul>
        <a class="painike painike--kulta" href={`/yhteystiedot?palvelu=${palvelu}`}>
          {nappi} <Ikoni nimi="nuoli" class="ikoni ikoni--nuoli" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Tumma osio erottuu vaaleiden osioiden välissä ja kertoo, että tämä on sivun ydin. */
  .kulku {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60rem 30rem at 85% -10%, rgb(226 189 104 / 16%), transparent 60%),
      radial-gradient(50rem 30rem at -10% 60%, rgb(95 138 124 / 28%), transparent 60%),
      linear-gradient(180deg, var(--kuusi), var(--kuusi-tumma));
  }
  .kulku__alku {
    max-width: 48rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  .kulku__alku h2 {
    color: #fff;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
  }
  .kulku__nostin {
    display: inline-block;
    margin: 0 0 0.9rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid rgb(226 189 104 / 50%);
    border-radius: 999px;
    color: var(--kulta-vaalea);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .kulku__nostin--tumma {
    border-color: rgb(125 93 30 / 40%);
    color: var(--messinki);
  }
  .kulku__johdatus {
    margin: 0;
    color: rgb(244 247 242 / 82%);
    font-size: 1.1875rem;
  }
  .kulku__johdatus strong {
    color: #fff;
  }

  /* Kolme lukua heti otsikon alla: lukija näkee vaivan ennen yksityiskohtia. */
  .kulku__luvut {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 1rem;
    margin: 0 0 clamp(2.5rem, 6vw, 4.5rem);
  }
  .kulku__luvut > div {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    align-items: center;
    padding: 1.15rem 1.25rem;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 16px;
    background: rgb(255 255 255 / 6%);
  }
  .kulku__luku-ikoni {
    grid-row: span 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 14px;
    background: linear-gradient(145deg, var(--kulta-vaalea), var(--kulta));
    color: var(--kuusi-tumma);
  }
  .kulku__luku-ikoni :global(.ikoni) {
    width: 1.5rem;
    height: 1.5rem;
  }
  .kulku__luvut dt {
    color: rgb(244 247 242 / 72%);
    font-size: 0.875rem;
  }
  .kulku__luvut dd {
    margin: 0;
    color: #fff;
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.2;
  }

  /* Vaiheet: kuvat ja tekstit vuorottelevat aikajanan molemmin puolin leveällä näytöllä. */
  .kulku__vaiheet {
    position: relative;
    list-style: none;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    margin: 0;
    padding: 0;
  }
  .kulku__vaihe {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }
  .kulku__kuva {
    max-width: 26rem;
    padding: 1.25rem;
    border-radius: 22px;
    background: linear-gradient(160deg, #fdfbf6, #efeadc);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 30%),
      0 30px 60px -30px rgb(0 0 0 / 55%);
  }
  .kulku__kuva :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .kulku__nro {
    display: block;
    margin-bottom: 0.25rem;
    background: linear-gradient(180deg, var(--kulta-vaalea), var(--kulta));
    background-clip: text;
    color: transparent;
    font-family: var(--serif);
    font-size: clamp(2.75rem, 6vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
  }
  .kulku__teksti h3 {
    margin: 0 0 0.5rem;
    color: #fff;
    font-size: clamp(1.35rem, 2.6vw, 1.65rem);
  }
  .kulku__kuvaus {
    margin: 0 0 1rem;
    color: rgb(244 247 242 / 82%);
  }
  .kulku__rivi {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
  }
  .kulku__rivi + .kulku__rivi {
    margin-top: 0.5rem;
  }
  .kulku__rivi p {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.95rem;
  }
  .kulku__rivi--te {
    border: 1px solid rgb(255 255 255 / 16%);
    background: rgb(255 255 255 / 5%);
    color: rgb(244 247 242 / 88%);
  }
  .kulku__rivi--me {
    border-left: 3px solid var(--kulta);
    background: rgb(226 189 104 / 12%);
    color: #fff;
  }
  .kulku__tunnus {
    color: var(--kulta-vaalea);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .kulku__aika {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: #fff;
    color: var(--kuusi-tumma);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .kulku__aika :global(.ikoni) {
    width: 0.95rem;
    height: 0.95rem;
  }
  .kulku__aika--vapaa {
    background: linear-gradient(180deg, var(--kulta-vaalea), var(--kulta));
  }

  @media (min-width: 60rem) {
    .kulku__vaihe {
      grid-template-columns: 1fr 1fr;
      gap: 7rem;
    }
    .kulku__vaihe:nth-child(even) .kulku__kuva {
      order: 2;
    }
    .kulku__vaihe:nth-child(odd) .kulku__kuva {
      justify-self: end;
    }
    /* Aikajana kulkee sarakkeiden välissä, ja jokaisen vaiheen kohdalla on kultainen piste. */
    .kulku__vaiheet::before {
      content: '';
      position: absolute;
      top: 2rem;
      bottom: 2rem;
      left: 50%;
      border-left: 2px dashed rgb(226 189 104 / 45%);
    }
    .kulku__vaihe {
      position: relative;
    }
    .kulku__vaihe::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 1.1rem;
      height: 1.1rem;
      margin: -0.55rem 0 0 -0.55rem;
      border-radius: 50%;
      background: var(--kulta);
      box-shadow:
        0 0 0 6px rgb(226 189 104 / 20%),
        0 0 0 12px rgb(226 189 104 / 8%);
    }
  }

  /* Paketti on vaalea kortti tummalla pohjalla, jotta lopputulos erottuu kuin lahja. */
  .kulku__paketti {
    display: grid;
    gap: 1.5rem 3rem;
    align-items: center;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: 24px;
    background: linear-gradient(160deg, #fdfbf6, #f1ecdf);
    color: var(--muste);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 60%);
  }
  @media (min-width: 58rem) {
    .kulku__paketti {
      grid-template-columns: 2fr 3fr;
    }
  }
  .kulku__paketti-kuva {
    max-width: 22rem;
    justify-self: center;
    width: 100%;
  }
  .kulku__paketti-kuva :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .kulku__paketti h3 {
    color: var(--kuusi);
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .kulku__paketti p:not(.kulku__nostin) {
    color: var(--harmaa);
  }
  .kulku__paketti :focus-visible {
    outline-color: var(--kohdistus);
  }
  .kulku__paketti ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 0.6rem 1.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
  }
  .kulku__paketti li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.6rem;
    align-items: start;
    font-size: 0.95rem;
  }
  .kulku__paketti li :global(.ikoni) {
    width: 1.6rem;
    height: 1.6rem;
    padding: 0.25rem;
    border-radius: 50%;
    background: var(--kuusi);
    color: var(--kulta-vaalea);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Pienet liikkeet tekevät kuvista eläviä. Ne kytkeytyvät pois, jos käyttäjä on pyytänyt vähemmän liikettä. */
    .kulku__kuva :global(.kulku__kursori) {
      animation: vilku 1.1s steps(1) infinite;
    }
    .kulku__kuva :global(.kulku__piste) {
      animation: pomppu 1.4s ease-in-out infinite;
    }
    .kulku__kuva :global(.kulku__piste:nth-child(2n)) {
      animation-delay: 0.2s;
    }
    .kulku__kuva :global(.kulku__tahti) {
      transform-box: fill-box;
      transform-origin: center;
      animation: tuike 2.6s ease-in-out infinite;
    }
    @supports (animation-timeline: view()) {
      .kulku__vaihe,
      .kulku__paketti,
      .kulku__luvut > div {
        animation: ilmesty linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 35%;
      }
      .kulku__kuva :global(.kulku__nimi) {
        stroke-dasharray: 260;
        animation: kirjoita linear both;
        animation-timeline: view();
        animation-range: entry 40% cover 50%;
      }
    }
  }
  @keyframes vilku {
    50% {
      opacity: 0;
    }
  }
  @keyframes pomppu {
    50% {
      transform: translateY(-3px);
    }
  }
  @keyframes tuike {
    50% {
      transform: scale(0.6) rotate(20deg);
      opacity: 0.6;
    }
  }
  @keyframes kirjoita {
    from {
      stroke-dashoffset: 260;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
