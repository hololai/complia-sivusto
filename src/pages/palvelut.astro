---
// Jokainen palvelu näkyy kerran: kortti kertoo, missä tilanteessa palvelu sopii, mitä se maksaa ja
// kauanko se kestää. Kortit on ryhmitelty tarpeen mukaan, jotta lukijan ei tarvitse osata palvelujen nimiä.
import Perus from '../layouts/Perus.astro';
import Kysymykset from '../components/Kysymykset.astro';
import Loppukehotus from '../components/Loppukehotus.astro';
import Ikoni, { type IkoninNimi } from '../components/Ikoni.astro';
import { SIVUSTO } from '../../site.config.mjs';
import { ARVIOINNIT, HINNAT, PAKETTI, eur, kiintea } from '../data/hinnat';
import { usein } from '../data/schema';

interface Kortti {
  ikoni: IkoninNimi;
  nimi: string;
  polku: string;
  kun: string;
  hinta: string;
  lisa: string;
}

type Hinnoiteltu = { pieni: number | null; keski: number; laaja: number };
const hinta = (p: Hinnoiteltu) => `${kiintea(p) ? '' : 'alkaen '}${eur(p.pieni ?? p.keski)}`;
const kortti = (
  p: Hinnoiteltu & { nimi: string; polku: string; toimitus: string },
  ikoni: IkoninNimi,
  kun: string,
): Kortti => ({ ikoni, nimi: p.nimi, polku: p.polku, kun, hinta: hinta(p), lisa: p.toimitus });

const RYHMAT: { otsikko: string; teksti: string; kortit: Kortti[] }[] = [
  {
    otsikko: 'Perusasiakirjat kuntoon',
    teksti: 'Nämä tarvitsee jokainen yritys, joka käsittelee asiakkaiden, työntekijöiden tai työnhakijoiden tietoja.',
    kortit: [
      kortti(HINNAT.tarkastus, 'suurennus', 'Kun ette tiedä, mitä tietosuojasta puuttuu. Saatte korjauslistan hintoineen.'),
      kortti(HINNAT.tietosuojaseloste, 'seloste', 'Kun asiakas pyytää tietosuojaselostetta tai tarjouspyyntö edellyttää sitä.'),
      kortti(HINNAT.seloste, 'lista', 'Kun teillä on vain vanha rekisteriseloste tai käsittelyjä ei ole kuvattu.'),
      {
        ikoni: 'tarkistus',
        nimi: `${PAKETTI.nimi} -paketti`,
        polku: '/hinnasto#paketti',
        kun: `Kun haluatte kaiken kerralla: ${PAKETTI.sisalto}.`,
        hinta: `alkaen ${eur(PAKETTI.pieni)}`,
        lisa: 'edullisempi kuin erikseen',
      },
    ],
  },
  {
    otsikko: 'Uusi järjestelmä tai tekoäly',
    teksti: 'Ennen kuin otatte käyttöön järjestelmän, joka käsittelee henkilötietoja.',
    kortit: [
      kortti(HINNAT.ennakkoarvio, 'kysymys', 'Kun otatte käyttöön Copilotin, ChatGPT:n tai muun järjestelmän ettekä tiedä, tarvitaanko arviointia.'),
      kortti(HINNAT.vaikutustenarviointi, 'kilpi', 'Kun käsittelette esimerkiksi terveystietoja tai lasten tietoja laajasti. Kaikki tarvittava sisältyy, myös alla olevat arvioinnit, kun niitä tarvitaan.'),
    ],
  },
  {
    otsikko: 'Yksittäinen arviointi',
    teksti: 'Kun ette tarvitse koko vaikutustenarviointia, voitte tilata yksittäisen arvioinnin kiinteään hintaan.',
    kortit: [
      kortti(ARVIOINNIT.lia, 'kaavio', 'Kun käsittely perustuu oikeutettuun etuun, mutta perustelua ei ole kirjattu.'),
      kortti(ARVIOINNIT.tia, 'lista', 'Kun tiedot siirtyvät EU:n ulkopuolelle vakiosopimuslausekkeilla.'),
      kortti(ARVIOINNIT.fria, 'asiantuntija', 'Kun otatte julkisena toimijana käyttöön suuririskisen tekoälyjärjestelmän.'),
    ],
  },
];

const KYSYMYKSET = [
  {
    k: 'Mitä GDPR vaatii yritykseltä käytännössä?',
    v: 'Useimmilta yrityksiltä tarvitaan ainakin tietosuojaselosteet, seloste käsittelytoimista, käsittelysopimukset henkilötietoja käsittelevien toimittajien kanssa, määritellyt säilytysajat ja ohje tietoturvaloukkauksen varalle.',
  },
  {
    k: 'Pitääkö palvelut ostaa kerralla?',
    v: 'Ei. Jokainen palvelu on kertaostos. Paketti on edullisin, jos tarvitsette useampaa asiakirjaa.',
  },
  {
    k: 'Miten hinta määräytyy?',
    v: 'Organisaation koon ja käsittelyn laajuuden mukaan: pieni, keskikokoinen tai laaja. Kaikki hinnat näkyvät hinnastossa.',
  },
];
---

<Perus
  otsikko={`Tietosuojapalvelut yrityksille – kiinteä hinta | ${SIVUSTO.nimi}`}
  kuvaus="GDPR-palvelut yritykselle valmiina: tietosuojaseloste, seloste käsittelytoimista, vaikutustenarviointi ja tarkastus. Julkiset hinnat ja toimitusajat."
  murut={[{ nimi: 'Palvelut', polku: '/palvelut' }]}
  schema={[usein(KYSYMYKSET)]}
>
  <section class="osio">
    <div class="kehys">
      <div class="osio__otsikko">
        <h1>Tietosuojapalvelut yrityksille</h1>
        <p class="johdatus">
          Saatte GDPR:n vaatimat asiakirjat valmiina ettekä työkalua, jolla ne pitäisi tehdä itse. Me teemme työn,
          te hyväksytte lopputuloksen, ja hinta on tiedossa etukäteen.
        </p>
      </div>
      {
        RYHMAT.map((r) => (
          <div class="palveluryhma">
            <h2>{r.otsikko}</h2>
            <p class="palveluryhma__teksti">{r.teksti}</p>
            <ul class="palvelukortit">
              {r.kortit.map((k) => (
                <li>
                  <a class="palvelukortti" href={k.polku}>
                    <span class="palvelukortti__yla">
                      <span class="palvelukortti__ikoni">
                        <Ikoni nimi={k.ikoni} />
                      </span>
                      <span class="palvelukortti__nimi">{k.nimi}</span>
                    </span>
                    <span class="palvelukortti__kun">{k.kun}</span>
                    <span class="palvelukortti__ala">
                      <span class="palvelukortti__hinta">{k.hinta}</span>
                      <span class="palvelukortti__lisa">{k.lisa}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="pieni">
        Hinnat alv 0 %. Kaikki koot näet <a href="/hinnasto">hinnastosta</a>. Etkö tiedä, mistä aloittaa?
        <a href="/pikatesti">Pikatesti</a> kertoo sen kahdessa minuutissa, tai <a href="/yhteystiedot">ota yhteyttä</a>.
      </p>
    </div>
  </section>

  <section class="osio osio--valkoinen">
    <div class="kehys kehys--kapea"><Kysymykset kysymykset={KYSYMYKSET} /></div>
  </section>

  <Loppukehotus />
</Perus>
