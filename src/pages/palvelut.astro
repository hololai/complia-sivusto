---
import Perus from '../layouts/Perus.astro';
import PalveluKortti from '../components/PalveluKortti.astro';
import Kysymykset from '../components/Kysymykset.astro';
import Loppukehotus from '../components/Loppukehotus.astro';
import { SIVUSTO } from '../../site.config.mjs';
import { ARVIOINNIT, ARVIOINTIEN_JARJESTYS, HINNAT, PAKETTI, PALVELUJEN_JARJESTYS, eur, kiintea } from '../data/hinnat';
import { usein } from '../data/schema';
import Ikoni from '../components/Ikoni.astro';

// Tietotilinpäätös on kuntien palvelu, joten se näkyy kuntasivulla eikä yrityksille.
const YRITYSPALVELUT = PALVELUJEN_JARJESTYS.filter((a) => a !== 'tietotilinpaatos');

const TILANTEET = [
  {
    tilanne: 'Asiakas pyytää tietosuojaselostetta tai tarjouspyyntö edellyttää sitä',
    ratkaisu: 'Tietosuojaselosteet',
    polku: HINNAT.tietosuojaseloste.polku,
  },
  {
    tilanne: 'Meillä on vain vanha rekisteriseloste',
    ratkaisu: 'Tietosuojaselosteet ja seloste käsittelytoimista',
    polku: '/artikkelit/rekisteriseloste-vai-tietosuojaseloste',
  },
  {
    tilanne: 'Otamme käyttöön Copilotin, ChatGPT:n tai uuden järjestelmän',
    ratkaisu: 'Ennakkoarvio',
    polku: HINNAT.ennakkoarvio.polku,
  },
  {
    tilanne: 'Käsittelemme terveystietoja tai lasten tietoja laajasti',
    ratkaisu: 'Vaikutustenarviointi',
    polku: HINNAT.vaikutustenarviointi.polku,
  },
  {
    tilanne: 'Käsittely perustuu oikeutettuun etuun, mutta perustelua ei ole kirjattu',
    ratkaisu: ARVIOINNIT.lia.nimi,
    polku: ARVIOINNIT.lia.polku,
  },
  {
    tilanne: 'Tiedot siirtyvät EU:n ulkopuolelle vakiosopimuslausekkeilla',
    ratkaisu: ARVIOINNIT.tia.nimi,
    polku: ARVIOINNIT.tia.polku,
  },
  {
    tilanne: 'Otamme julkisena toimijana käyttöön suuririskisen tekoälyjärjestelmän',
    ratkaisu: ARVIOINNIT.fria.nimi,
    polku: ARVIOINNIT.fria.polku,
  },
  {
    tilanne: 'Emme tiedä, mitä tietosuojasta puuttuu',
    ratkaisu: HINNAT.tarkastus.nimi,
    polku: HINNAT.tarkastus.polku,
  },
  {
    tilanne: 'Haluamme kaiken kerralla kuntoon',
    ratkaisu: `${PAKETTI.nimi} -paketti`,
    polku: '/hinnasto#paketti',
  },
];

const KYSYMYKSET = [
  {
    k: 'Mitä GDPR vaatii yritykseltä käytännössä?',
    v: 'Useimmilta yrityksiltä tarvitaan ainakin tietosuojaselosteet, seloste käsittelytoimista, käsittelysopimukset henkilötietoja käsittelevien toimittajien kanssa, määritellyt säilytysajat ja ohje tietoturvaloukkauksen varalle.',
  },
  {
    k: 'Pitääkö palvelut ostaa kerralla?',
    v: 'Ei. Jokainen palvelu on kertaostos. Paketti on edullisin, jos tarvitsette useampaa asiakirjaa.',
  },
  {
    k: 'Miten hinta määräytyy?',
    v: 'Organisaation koon ja käsittelyn laajuuden mukaan: pieni, keskikokoinen tai laaja. Kaikki hinnat näkyvät hinnastossa.',
  },
];
---

<Perus
  otsikko={`Tietosuojapalvelut yrityksille – kiinteä hinta | ${SIVUSTO.nimi}`}
  kuvaus="GDPR-palvelut yritykselle valmiina: tietosuojaseloste, seloste käsittelytoimista, vaikutustenarviointi ja tarkastus. Julkiset hinnat ja toimitusajat."
  murut={[{ nimi: 'Palvelut', polku: '/palvelut' }]}
  schema={[usein(KYSYMYKSET)]}
>
  <section class="osio">
    <div class="kehys">
      <div class="osio__otsikko">
        <h1>Tietosuojapalvelut yrityksille</h1>
        <p class="johdatus">
          Saatte GDPR:n vaatimat asiakirjat valmiina ettekä työkalua, jolla ne pitäisi tehdä itse. Me teemme työn,
          te hyväksytte lopputuloksen, ja hinta on tiedossa etukäteen.
        </p>
      </div>
      <h2 class="valitsin__otsikko">Mikä tilanteenne on?</h2>
      <ul class="valitsin">
        {
          TILANTEET.map((t) => (
            <li>
              <a class="valinta" href={t.polku}>
                <span class="valinta__tilanne">{t.tilanne}</span>
                <span class="valinta__ratkaisu">
                  {t.ratkaisu}
                  <Ikoni nimi="nuoli" class="ikoni" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="pieni">
        Etkö löydä tilannettanne? <a href="/pikatesti">Pikatesti</a> kertoo kahdessa minuutissa, mistä kannattaa
        aloittaa, tai <a href="/yhteystiedot">ota yhteyttä</a>.
      </p>
    </div>
  </section>

  <section class="osio osio--valkoinen">
    <div class="kehys">
      <div class="osio__otsikko">
        <h2>Kaikki palvelut kiinteällä hinnalla</h2>
        <p class="johdatus">Jokaisella palvelulla on julkinen hinta ja luvattu toimitusaika. Hinnat alv 0 %.</p>
      </div>
      <div class="ruudukko">
        {YRITYSPALVELUT.map((a) => <PalveluKortti avain={a} />)}
      </div>
      <h3 class="lisaarvioinnit__otsikko">Lisäarvioinnit tarpeen mukaan</h3>
      <p class="pieni lisaarvioinnit__teksti">
        Tasapainotesti ja siirtovaikutusten arviointi sisältyvät vaikutustenarviointiin, kun niitä tarvitaan. Erikseen
        ostettuna niillä on kiinteä hinta.
      </p>
      <div class="ruudukko">
        {
          ARVIOINTIEN_JARJESTYS.map((a) => (
            <article class="kortti kortti--palvelu">
              <h4>
                <a href={ARVIOINNIT[a].polku}>{ARVIOINNIT[a].nimi}</a>
              </h4>
              <p>{ARVIOINNIT[a].lyhyt}</p>
              <div class="kortti__ala">
                <span class="kortti__hinta">
                  {kiintea(ARVIOINNIT[a]) ? '' : 'alkaen '}
                  {eur(ARVIOINNIT[a].pieni)}
                </span>
                <span class="pieni">{ARVIOINNIT[a].toimitus}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="osio">
    <div class="kehys kehys--kapea">
      <div class="kortti polku">
        <h2>{PAKETTI.nimi} -paketti</h2>
        <p>
          GAP-analyysi, tietosuojaselosteet ja seloste käsittelytoimista yhdessä edullisemmin kuin erikseen. Pienelle
          yritykselle {eur(PAKETTI.pieni)}.
        </p>
        <p class="lisalinkki"><a href="/hinnasto#paketti">Katso paketin hinnat</a></p>
      </div>
    </div>
  </section>

  <section class="osio osio--valkoinen">
    <div class="kehys kehys--kapea"><Kysymykset kysymykset={KYSYMYKSET} /></div>
  </section>

  <Loppukehotus />
</Perus>
