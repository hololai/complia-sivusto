---
import Perus from '../layouts/Perus.astro';
import Kysymykset from '../components/Kysymykset.astro';
import Loppukehotus from '../components/Loppukehotus.astro';
import Teksti from '../components/Teksti.astro';
import { SIVUSTO } from '../../site.config.mjs';
import { HINNAT, eur } from '../data/hinnat';
import { POHJA, POHJA_OTSIKKO, POHJA_PAIVAYS, kirjain, pohjaTekstina } from '../data/pohja';
import { usein } from '../data/schema';

const KYSYMYKSET = [
  {
    k: 'Saako pohjaa käyttää vapaasti?',
    v: 'Saa. Pohjan voi kopioida ja muokata omaan käyttöön ilmaiseksi, eikä lataamiseen tarvita sähköpostia.',
  },
  {
    k: 'Riittääkö täytetty pohja lain vaatimuksiin?',
    v: 'Se voi riittää, jos kuvaat käsittelyt oikein ja kaikki kohdat on täytetty. Pohja on yleinen malli, eikä se korvaa käsittelyjesi arviointia.',
  },
  {
    k: 'Onko tämä sama kuin rekisteriselosteen pohja?',
    v: 'Tämä korvaa vanhan rekisteriselosteen. Nykyinen tietosuojaseloste sisältää myös kohdat, joita vanhoissa pohjissa ei yleensä ole, kuten oikeusperusteen ja säilytysajan.',
  },
];

const VIRHEET = [
  { otsikko: 'Säilytysaika jää täyttämättä', teksti: '"Toistaiseksi" ei riitä. Määritä aika tai peruste, jolla se lasketaan.' },
  { otsikko: 'Työntekijät unohtuvat', teksti: 'Tämä pohja koskee asiakkaita. Tee erillinen seloste työntekijöille ja työnhakijoille.' },
  { otsikko: 'Toimittajat puuttuvat', teksti: 'Käy läpi sähköposti, palkanlaskenta ja verkkosivut. Moni niistä siirtää tietoja EU:n ulkopuolelle.' },
  { otsikko: 'Seloste jää paikoilleen', teksti: 'Päivitä se aina, kun järjestelmä tai toimittaja vaihtuu.' },
];
---

<Perus
  otsikko={`Tietosuojaselosteen pohja: ilmainen malli | ${SIVUSTO.nimi}`}
  kuvaus="Ilmainen tietosuojaselosteen pohja yritykselle. Malli ja täyttöohje avoimesti sivulla, ja saat sen myös Word-tiedostona ilman sähköpostiosoitetta."
  murut={[{ nimi: 'Pikatesti', polku: '/pikatesti' }, { nimi: 'Tietosuojaselosteen pohja', polku: '/tietosuojaselostepohja' }]}
  schema={[usein(KYSYMYKSET)]}
>
  <section class="osio">
    <div class="kehys">
      <div class="osio__otsikko">
        <h1>Tietosuojaselosteen pohja: ilmainen malli yritykselle</h1>
        <p class="johdatus">
          Täytä keltaiset kohdat omilla tiedoillasi, valitse sopivat vaihtoehdot ja poista ohjeet. Sähköpostia ei tarvita.
        </p>
        <div class="painikkeet">
          <a class="painike" href="/lataukset/tietosuojaseloste-pohja.docx" download>Lataa pohja (Word)</a>
          <button class="painike painike--toinen" type="button" data-kopioi hidden>Kopioi teksti</button>
          <a class="painike painike--toinen" href="/tietosuojaseloste">Teetä valmiina, alkaen {eur(HINNAT.tietosuojaseloste.pieni)}</a>
        </div>
        <p class="pieni" role="status" data-kopioi-tila></p>
      </div>

      <div class="pohja">
        <aside class="pohja__opas" aria-labelledby="opas-otsikko">
          <h2 id="opas-otsikko">Näin täytät pohjan</h2>
          <ol class="pohja__vaiheet">
            <li><strong>Listaa järjestelmät</strong> ja niiden toimittajat.</li>
            <li><strong>Täytä keltaiset kohdat</strong> ja lisää puuttuvat käsittelyt.</li>
            <li><strong>Valitse vaihtoehdot</strong> ja poista ohjeet.</li>
            <li><strong>Julkaise seloste</strong> paikkaan, josta sen löytää helposti.</li>
          </ol>
          <dl class="pohja__selite">
            <div><dt><span class="kentta">[keltainen]</span></dt><dd>täytä omilla tiedoilla</dd></div>
            <div><dt><span class="pohja__selite-ohje">Ohje</span></dt><dd>poista ennen julkaisua</dd></div>
            <div><dt><span class="pohja__selite-vaihto">A / B</span></dt><dd>valitse yksi</dd></div>
          </dl>
        </aside>

        <article class="arkki" id="pohja" aria-labelledby="pohja-otsikko">
          <header class="arkki__yla">
            <h2 id="pohja-otsikko"><Teksti teksti={POHJA_OTSIKKO} /></h2>
            <p class="arkki__paivays"><Teksti teksti={POHJA_PAIVAYS} /></p>
          </header>
          {
            POHJA.map((osio, i) => (
              <section class="arkki__osio">
                <span class="arkki__numero" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3>
                    <span class="visually-hidden">{i + 1}. </span>
                    {osio.otsikko}
                  </h3>
                  {osio.osat.map((osa) => {
                    if (osa.tyyppi === 'kappale') return <p><Teksti teksti={osa.teksti} /></p>;
                    if (osa.tyyppi === 'rivit')
                      return (
                        <p>
                          {osa.rivit.map((r, j) => (
                            <>
                              {j > 0 && <br />}
                              <Teksti teksti={r} />
                            </>
                          ))}
                        </p>
                      );
                    if (osa.tyyppi === 'lista')
                      return (
                        <ul>
                          {osa.kohdat.map((k) => (
                            <li><Teksti teksti={k} /></li>
                          ))}
                        </ul>
                      );
                    if (osa.tyyppi === 'taulukko')
                      return (
                        <div class="taulu">
                          <table class="taulukko">
                            <thead>
                              <tr>{osa.otsikot.map((o) => <th scope="col">{o}</th>)}</tr>
                            </thead>
                            <tbody>
                              {osa.rivit.map((r) => (
                                <tr>{r.map((solu) => <td><Teksti teksti={solu} /></td>)}</tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      );
                    if (osa.tyyppi === 'vaihtoehdot')
                      return (
                        <div class="vaihtoehdot">
                          {osa.vaihtoehdot.map((v, j) => (
                            <p class="vaihtoehto">
                              <span class="vaihtoehto__nimi">Vaihtoehto {kirjain(j)}</span>
                              <Teksti teksti={v} />
                            </p>
                          ))}
                        </div>
                      );
                    return (
                      <p class="arkki__ohje">
                        <strong>Ohje:</strong> {osa.teksti}
                      </p>
                    );
                  })}
                </div>
              </section>
            ))
          }
        </article>
      </div>
      <template data-pohja-teksti>{pohjaTekstina()}</template>
    </div>
  </section>

  <section class="osio osio--valkoinen">
    <div class="kehys">
      <div class="osio__otsikko">
        <h2>Mihin pohjan käyttäjät yleensä kompastuvat</h2>
        <p class="johdatus">Lue tarkemmin, <a href="/artikkelit/mita-tietosuojaselosteessa-pitaa-olla">mitä tietosuojaselosteessa pitää olla</a>.</p>
      </div>
      <div class="ruudukko">
        {
          VIRHEET.map((v) => (
            <div class="kortti">
              <h3>{v.otsikko}</h3>
              <p>{v.teksti}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="osio">
    <div class="kehys"><Kysymykset kysymykset={KYSYMYKSET} /></div>
  </section>

  <Loppukehotus
    otsikko="Haluatko selosteet valmiina?"
    teksti={`Teemme selosteet asiakkaille, työntekijöille, työnhakijoille ja verkkosivuille kolmessa arkipäivässä, alkaen ${eur(HINNAT.tietosuojaseloste.pieni)} (alv 0 %).`}
    nappi="Katso tietosuojaselosteet"
    linkki="/tietosuojaseloste"
  />
</Perus>

<script src="../scripts/kopioi.ts"></script>
