---
import Perus from '../layouts/Perus.astro';
import Ikoni from '../components/Ikoni.astro';
import Loppukehotus from '../components/Loppukehotus.astro';
import { SIVUSTO } from '../../site.config.mjs';

const { tiimi } = SIVUSTO;
---

<Perus
  otsikko={`Meistä: tietosuojan ja IT:n asiantuntijat | ${SIVUSTO.nimi}`}
  kuvaus="Complian asiantuntijat yhdistävät tietosuojan ja IT:n. Lue taustamme, työtapamme ja se, miten käsittelemme tietojanne."
  murut={[{ nimi: 'Meistä', polku: '/meista' }]}
>
  <section class="osio">
    <div class="kehys">
      <div class="osio__otsikko">
        <h1>Meistä</h1>
        <p class="johdatus">
          {SIVUSTO.nimi} on kahden tietosuojan ja IT:n asiantuntijan yritys. Teemme tietosuoja-asiakirjat valmiiksi
          kiinteällä hinnalla. {SIVUSTO.iskulause}
        </p>
      </div>

      <article class="kortti tiimi">
        <h2>Kaksi tietosuojan ja IT:n asiantuntijaa</h2>
        <ul class="tarkistukset tiimi__lista">
          {
            tiimi.map((t) => (
              <li>
                <Ikoni nimi="tarkistus" />
                <span>{t.charAt(0).toUpperCase() + t.slice(1)}</span>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </section>

  <section class="osio">
    <div class="kehys proosa">
      <h2>Miten työskentelemme</h2>
      <p>
        Oma Complia-työkalumme tekee dokumentoinnista nopeaa, ja siksi kiinteä hinta on mahdollinen. Työkalu ei
        kuitenkaan päätä mitään: asiantuntija tarkistaa jokaisen asiakirjan ennen luovutusta ja vastaa sen sisällöstä.
      </p>
      <p>
        Asiakas ei opettele ohjelmistoa eikä täytä lomakkeita. Haastattelemme teitä, teemme asiakirjat ja käymme
        muutokset läpi kanssanne. Saatte valmiit asiakirjat muokattavina tiedostoina, ja ne ovat teidän.
      </p>

      <h2>Tietosuoja ja IT samassa paketissa</h2>
      <p>
        Emme ole juristeja vaan tietosuojan ja IT:n asiantuntijoita. Tietosuoja ratkeaa usein järjestelmissä:
        käyttöoikeuksissa, säilytysajoissa, toimittajien sopimuksissa ja siinä, mihin tekoälytyökalu pääsee käsiksi.
        Ymmärrämme sekä lain vaatimukset että sen, miten Microsoft 365, Google Workspace ja tekoälypalvelut toimivat
        käytännössä.
      </p>
      <div class="taulu" role="region" aria-label="Teemme ja emme tee" tabindex="0">
      <table>
        <thead>
          <tr><th scope="col">Teemme</th><th scope="col">Emme tee</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>tietosuojaselosteet, selosteet käsittelytoimista ja ohjeet</td>
            <td>oikeudellisia lausuntoja riita- tai sopimustilanteisiin</td>
          </tr>
          <tr>
            <td>vaikutustenarvioinnit, tasapainotestit, siirtojen ja tekoälyn arvioinnit</td>
            <td>edustusta tuomioistuimessa tai seuraamusmaksumenettelyssä</td>
          </tr>
          <tr>
            <td>tietosuojatarkastukset ja tietosuojavastaavan tehtävät</td>
            <td>sopimusneuvotteluja asiakkaan puolesta</td>
          </tr>
        </tbody>
      </table>
      </div>
      <p>Jos tilanne vaatii oikeudellista tulkintaa, kerromme sen suoraan ja ohjaamme juristille.</p>

      <h2>Miten käsittelemme teidän tietojanne</h2>
      <p>
        Tarvitsemme työhön vähän henkilötietoja. Asiakirjoissa kuvataan tietoryhmiä ja käsittelyjä, ei yksittäisiä
        ihmisiä, joten emme pyydä asiakkaidenne, potilaidenne tai työntekijöidenne tietoja. Käsittelemme lähinnä
        yhteyshenkilöidenne nimiä ja yhteystietoja.
      </p>
      <dl class="tiedot">
        <div>
          <dt>Missä tiedot ovat</dt>
          <dd>
            Omassa Complia-työkalussamme, joka toimii Googlen pilvipalvelussa EU:ssa.
          </dd>
        </div>
        <div>
          <dt>Kuka niihin pääsee</dt>
          <dd>
            Vain nimetty asiantuntijamme kirjautuu työkaluun. Asiakasorganisaatioiden tiedot erotetaan toisistaan
            tietokannan pääsysäännöillä, ja kehitystyö tehdään erillisessä ympäristössä testidatalla.
          </dd>
        </div>
        <div>
          <dt>Tekoäly</dt>
          <dd>
            Käytämme tekoälyä tekstien luonnosteluun, mutta kehotteisiin ei viedä henkilötietoja: nimet korvataan
            rooleilla ja asiakkaan nimi paikkamerkillä.
          </dd>
        </div>
        <div>
          <dt>Kuinka kauan</dt>
          <dd>
            Toimeksiannon ajan. Kun sopimus päättyy, saatte asiakirjat Word-tiedostoina,
            ja poistamme tietonne työkalusta. Tekninen vientikopio ja varmuuskopiot poistetaan 30 päivän kuluessa.
          </dd>
        </div>
      </dl>
      <p>
        Tarkemmat ehdot ovat <a href="/kasittelysopimus">käsittelysopimuksessa</a>, joka liitetään jokaiseen
        tilaukseen.
      </p>
      <p>
        Oma sivustomme on samalla näyte työstämme: staattiset sivut ilman evästeitä, lomakkeita, kävijäseurantaa,
        ulkoisia fontteja tai seurantapikseleitä. Lue <a href="/tietosuoja">tietosuojaselosteemme</a>.
      </p>
    </div>
  </section>
  <Loppukehotus />
</Perus>

<style>
  .asiantuntija h2 {
    font-size: 1.5rem;
    margin-bottom: 0.15rem;
  }
  .asiantuntija ul {
    margin: 0;
    padding-left: 1.15rem;
  }
  .asiantuntija li {
    margin-bottom: 0.3rem;
  }
</style>
