---
import { getCollection } from 'astro:content';
import Perus from '../../layouts/Perus.astro';
import Loppukehotus from '../../components/Loppukehotus.astro';
import Ikoni from '../../components/Ikoni.astro';
import { SIVUSTO } from '../../../site.config.mjs';

const artikkelit = (await getCollection('artikkelit')).sort((a, b) => a.data.jarjestys - b.data.jarjestys);
const KOHDE = { yritykset: 'Yrityksille', kunnat: 'Kunnille', molemmat: 'Yrityksille ja kunnille' };
const RYHMAT = [
  { id: 'ohjelmistot', nimi: 'Tekoäly ja ohjelmistot', kuvaus: 'Microsoft 365, Copilot, Google Workspace, Gemini, Claude Team ja muut työkalut.' },
  { id: 'arvioinnit', nimi: 'Arvioinnit: DPIA, LIA, TIA ja FRIA', kuvaus: 'Milloin arviointi tarvitaan ja miten se tehdään.' },
  { id: 'perusasiat', nimi: 'Tietosuojan perusasiat', kuvaus: 'Selosteet, tietosuojavastaava ja toiminta tietomurron sattuessa.' },
  { id: 'kunnat', nimi: 'Kunnat', kuvaus: 'Kuntien tietosuojatyö ja sen aikataulut.' },
] as const;
---

<Perus
  otsikko={`Tietosuojaohjeet yrityksille ja kunnille | ${SIVUSTO.nimi}`}
  kuvaus="Selkeät ohjeet tietosuojaselosteesta, vaikutustenarvioinnista, LIA:sta, TIA:sta, FRIA:sta, Copilotista, Geministä ja Claude Teamista."
  murut={[{ nimi: 'Ohjeet', polku: '/artikkelit' }]}
>
  <section class="osio">
    <div class="kehys">
      <div class="osio__otsikko">
        <h1>Tietosuojaohjeet yrityksille ja kunnille</h1>
        <p class="johdatus">
          Mitä laki vaatii, mitä se tarkoittaa käytännössä ja milloin työ kannattaa ostaa valmiina. Lähteet on
          merkitty jokaiseen ohjeeseen.
        </p>
      </div>
      <div class="ruudukko ruudukko--2">
        <article class="kortti kortti--palvelu">
          <span class="kortti__ikoni"><Ikoni nimi="kysymys" /></span>
          <h2><a href="/pikatesti">Tietosuojan pikatesti</a></h2>
          <p>Kahden minuutin testi kertoo, mistä kannattaa aloittaa. Vastauksia ei tallenneta.</p>
        </article>
        <article class="kortti kortti--palvelu">
          <span class="kortti__ikoni"><Ikoni nimi="seloste" /></span>
          <h2><a href="/tietosuojaselostepohja">Tietosuojaselosteen pohja</a></h2>
          <p>Ilmainen pohja täyttöohjeineen, myös Word-tiedostona.</p>
        </article>
      </div>
      {
        RYHMAT.map((r) => (
          <section class="artikkeliryhma" id={r.id}>
            <h2>{r.nimi}</h2>
            <p class="artikkeliryhma__kuvaus">{r.kuvaus}</p>
            <div class="ruudukko ruudukko--2">
              {artikkelit
                .filter((a) => a.data.ryhma === r.id)
                .map((a) => (
                  <article class="kortti">
                    <p class="nostin">{KOHDE[a.data.kohde]}</p>
                    <h3>
                      <a href={`/artikkelit/${a.id}`}>{a.data.h1}</a>
                    </h3>
                    <p>{a.data.tiivistelma}</p>
                  </article>
                ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
  <Loppukehotus />
</Perus>

<style>
  .artikkeliryhma {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .artikkeliryhma h2 {
    margin-bottom: 0.25rem;
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.9rem);
  }
  .artikkeliryhma__kuvaus {
    margin-bottom: 1.25rem;
    color: var(--harmaa);
  }
</style>
