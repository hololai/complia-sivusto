---
// Vastaanottopalvelu ohjaa tänne onnistuneen lähetyksen jälkeen. Ei hakukoneisiin eikä sivukarttaan.
import Perus from '../layouts/Perus.astro';
import { SIVUSTO } from '../../site.config.mjs';
---

<Perus otsikko={`Kiitos yhteydenotosta | ${SIVUSTO.nimi}`} kuvaus="Viestinne on vastaanotettu. Vastaamme sähköpostilla ja vahvistamme kiinteän hinnan ja toimitusajan kirjallisena." noindex>
  <section class="osio">
    <div class="kehys proosa">
      <h1>Kiitos, viestinne on lähetetty</h1>
      <p class="johdatus">
        Vastaamme sähköpostilla ja vahvistamme kiinteän hinnan ja toimitusajan kirjallisena ennen kuin työ alkaa.
      </p>
      <p>Sillä välin voitte tutustua <a href="/hinnasto">hinnastoon</a> tai <a href="/artikkelit">tietosuojaohjeisiin</a>.</p>
    </div>
  </section>
</Perus>
