---
import { getCollection, getEntry } from 'astro:content';
import Perus from '../layouts/Perus.astro';
import Kysymykset from '../components/Kysymykset.astro';
import Loppukehotus from '../components/Loppukehotus.astro';
import PalvelunKulku from '../components/PalvelunKulku.astro';
import Ikoni from '../components/Ikoni.astro';
import { KULUT } from '../data/kulut';
import { SIVUSTO } from '../../site.config.mjs';
import { ARVIOINNIT, HINNAT, JARJESTELMAT, JATKUVAT, KOOT, eur, kiintea, sijoitaHinnat } from '../data/hinnat';
import { palvelu as palveluSchema, usein } from '../data/schema';
import { jaaOsiin, kaariTaulukot } from '../data/html';

export async function getStaticPaths() {
  const palvelut = await getCollection('palvelut');
  return palvelut.map((p) => ({ params: { palvelu: p.id }, props: { p } }));
}

const { p } = Astro.props;
// Hinnat sijoitetaan valmiiseen HTML:ään vasta tässä, jotta välimuistiin ei jää vanhoja hintoja.
// Teksti on osion "Lisätietoa palvelusta" alla, joten sen otsikot lasketaan yhdellä tasolla.
const alemmas = (html: string) => html.replace(/<(\/?)h([2-5])([\s>])/g, (_, v, n, l) => `<${v}h${Number(n) + 1}${l}`);
const osat = jaaOsiin(kaariTaulukot(sijoitaHinnat(p.rendered?.html ?? '')));
const alkuteksti = alemmas(osat.alku);
const osiot = osat.osiot.map((o) => ({ otsikko: alemmas(o.otsikko), sisalto: alemmas(o.sisalto) }));
const d = p.data;

const onJatkuva = d.avain === 'vastaava';
const KAIKKI_HINNAT = { ...HINNAT, ...ARVIOINNIT, vastaava: JATKUVAT.vastaava };
const hintatieto = KAIKKI_HINNAT[d.avain as keyof typeof KAIKKI_HINNAT];
if (!hintatieto) throw new Error(`Palvelun ${p.id} hintatunnusta ei löydy: ${d.avain}`);
const toimitus = 'toimitus' in hintatieto ? hintatieto.toimitus : 'aloitus sovitaan tilauksen yhteydessä';
const yksikko = 'yksikko' in hintatieto ? hintatieto.yksikko : null;
const paate = onJatkuva ? '/kk' : '';

// Kiinteä hinta näytetään yhtenä rivinä, jotta samaa lukua ei toisteta kolmesti.
const koot = kiintea(hintatieto)
  ? [{ nimi: 'Kaikki kokoluokat', lisa: '', hinta: hintatieto.keski, ylin: null }]
  : KOOT.map((k) => ({
      // Tietotilinpäätöksen koko tarkoittaa kuntaa, joten sillä on omat nimensä.
      nimi: d.avain === 'tietotilinpaatos' ? (k.id === 'keski' ? 'Keskikokoinen kunta' : 'Iso kunta') : k.nimi,
      lisa: d.avain === 'tietotilinpaatos' ? '' : k.lyhyt,
      hinta: hintatieto[k.id],
      // Vaikutustenarvioinnin hinta riippuu myös järjestelmästä, joten näytetään koko vaihteluväli.
      ylin: d.avain === 'vaikutustenarviointi' ? JARJESTELMAT.arkaluonteinen[k.id] : null,
    })).filter((k): k is { nimi: string; lisa: string; hinta: number; ylin: number | null } => k.hinta !== null);

// Jokaisella palvelulla on kuvallinen kulku. Puuttuva kulku on virhe, jotta uusi palvelu ei jää ilman sitä.
const kulku = KULUT[p.id];
if (!kulku) throw new Error(`Palvelulta ${p.id} puuttuu kulku tiedostosta src/data/kulut.ts`);
const nappi = onJatkuva ? 'Ota yhteyttä' : 'Tilaa palvelu';
const alin = koot[0];

const usein_ = d.usein.map((q) => ({ k: q.k, v: sijoitaHinnat(q.v) }));
const kuvaus = sijoitaHinnat(d.kuvaus);
const polku = `/${p.id}`;
const artikkeli = d.artikkeli ? await getEntry('artikkelit', d.artikkeli) : undefined;
if (d.artikkeli && !artikkeli) throw new Error(`Palvelun ${p.id} artikkelia ei löydy: ${d.artikkeli}`);
---

<Perus
  otsikko={sijoitaHinnat(d.otsikko)}
  kuvaus={kuvaus}
  murut={[{ nimi: 'Palvelut', polku: '/palvelut' }, { nimi: d.nimi, polku }]}
  schema={[
    palveluSchema({
      nimi: d.nimi,
      kuvaus,
      polku,
      hinnat: koot.map((k) => ({ koko: k.nimi, hinta: k.hinta })),
      kuukausi: onJatkuva,
    }),
    usein(usein_),
  ]}
>
  <section class="osio palvelu__paa">
    <div class="kehys palvelu__ruudukko">
      <div class="palvelu__teksti">
        <h1>{d.h1}</h1>
        <p class="johdatus">{d.johdanto}</p>
        <p class="palvelu__sopii"><strong>Sopii, jos</strong> {d.sopii}</p>
        <p class="palvelu__kulkulinkki">
          <a href="#nain-se-etenee">Katso, miten työ etenee</a>
        </p>
      </div>
      <aside class="hintakortti" aria-label={`Hinta: ${d.nimi}`}>
        <p class="hintakortti__hinta">
          {koot.length > 1 && <span>alkaen</span>}
          {eur(alin.hinta)}{paate}
        </p>
        <p class="hintakortti__toimitus">Toimitus {toimitus}{yksikko && <>, hinta {yksikko}</>}</p>
        <ul class="hintakortti__lupaukset">
          {
            (onJatkuva
              ? ['Kiinteä kuukausihinta kirjallisena', 'Maksuton kartoitus ennen sopimusta']
              : ['Kiinteä hinta kirjallisena', 'Lasku vasta, kun hyväksytte']
            ).map((l) => (
              <li>
                <Ikoni nimi="tarkistus" />
                {l}
              </li>
            ))
          }
        </ul>
        <a class="painike painike--kulta painike--iso hintakortti__painike" href={`/yhteystiedot?palvelu=${p.id}`}>
          {nappi} <Ikoni nimi="nuoli" class="ikoni ikoni--nuoli" />
        </a>
        <p class="pieni hintakortti__kysy">
          Alv 0 %. {koot.length > 1 && <><a href="#hinnat">Hinnat kokoluokittain</a>.</>}
        </p>
      </aside>
    </div>
  </section>

  <PalvelunKulku kulku={kulku} palvelu={p.id} nappi={nappi} />

  <section class="osio osio--valkoinen">
    <div class="kehys kehys--kapea">
      <h2>Lisätietoa palvelusta</h2>
      <div class="kysymykset">
        <details class="ukk ukk--laaja" id="hinnat">
          <summary><h3>Hinnat kokoluokittain</h3></summary>
          <div class="proosa">
            <ul class="rivit">
              {
                koot.map((k) => (
                  <li>
                    <span>
                      {k.nimi}
                      {k.lisa && <span class="pieni"> {k.lisa}</span>}
                    </span>
                    <span>
                      {k.ylin ? `${eur(k.hinta).slice(0, -2)}–${eur(k.ylin)}` : eur(k.hinta)}
                      {paate}
                    </span>
                  </li>
                ))
              }
            </ul>
            {
              d.avain === 'vaikutustenarviointi' && (
                <p>
                  Hinta riippuu järjestelmästä, ja siihen sisältyvät ennakkoarvio ja kirjaukset selosteisiin. Katso
                  <a href="/hinnasto#jarjestelmat">hinnat järjestelmittäin</a>.
                </p>
              )
            }
            <p class="pieni">Hinnat alv 0 % (alv 25,5 % lisätään). Kaikki palvelut näette <a href="/hinnasto">hinnastosta</a>.</p>
          </div>
        </details>
        <details class="ukk ukk--laaja">
          <summary><h3>Mitä hintaan sisältyy</h3></summary>
          <div class="proosa">
            <p class="isokirjain">{d.saat}</p>
            <p><strong>Teiltä tarvitsemme</strong> {d.tarvitsemme}</p>
          </div>
        </details>
        {
          osiot.map((o) => (
            <details class="ukk ukk--laaja">
              <summary set:html={o.otsikko} />
              <div class="proosa" set:html={o.sisalto} />
            </details>
          ))
        }
      </div>
      {alkuteksti && <div class="proosa palvelu__alku" set:html={alkuteksti} />}

      <div class="palvelu__ukk">
        <Kysymykset kysymykset={usein_} />
      </div>
      {
        artikkeli && (
          <p class="lahteet">
            <strong>Lue lisää:</strong> <a href={`/artikkelit/${artikkeli.id}`}>{artikkeli.data.h1}</a>
          </p>
        )
      }
    </div>
  </section>

  <Loppukehotus
    otsikko={`${d.nimi}: tilaa tai kysy lisää`}
    teksti="Kertokaa lyhyesti tilanteenne, niin vahvistamme kiinteän hinnan ja toimitusajan kirjallisena."
    nappi={nappi}
    linkki={`/yhteystiedot?palvelu=${p.id}`}
  />
</Perus>
