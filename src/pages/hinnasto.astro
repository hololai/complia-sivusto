---
import Perus from '../layouts/Perus.astro';
import Kysymykset from '../components/Kysymykset.astro';
import Loppukehotus from '../components/Loppukehotus.astro';
import Aloitus from '../components/Aloitus.astro';
import { SIVUSTO } from '../../site.config.mjs';
import {
  ARVIOINNIN_SISALTO,
  ARVIOINNIT,
  HINNAT,
  JARJESTELMAT,
  JARJESTELMIEN_JARJESTYS,
  JATKUVAT,
  KOKONAISUUDET,
  KOOT,
  PAKETTI,
  eur,
  kiintea,
  pakettiErikseen,
} from '../data/hinnat';
import { usein } from '../data/schema';

// Perusasiakirjat hinnoitellaan koon mukaan. Ennakkoarvio ja vaikutustenarviointi ovat
// omassa osiossaan, jotta jokainen hinta näkyy vain yhdessä paikassa.
const PERUS = ['tarkastus', 'tietosuojaseloste', 'seloste', 'tietotilinpaatos'] as const;

const ERILLISET = [
  { ...HINNAT.ennakkoarvio, yksikko: 'hyvitetään, jos jatkatte arviointiin' },
  ARVIOINNIT.lia,
  ARVIOINNIT.tia,
  ARVIOINNIT.fria,
];

const KYSYMYKSET = [
  {
    k: 'Mitä tietosuojaseloste maksaa?',
    v: `Kaikki tarvittavat tietosuojaselosteet maksavat koon mukaan ${eur(HINNAT.tietosuojaseloste.pieni)}, ${eur(HINNAT.tietosuojaseloste.keski)} tai ${eur(HINNAT.tietosuojaseloste.laaja)} (alv 0 %). Hintaan kuuluvat selosteet asiakkaille, työntekijöille, työnhakijoille ja verkkosivuille, eikä se riipu selosteiden määrästä.`,
  },
  {
    k: 'Mitä vaikutustenarvioinnin hintaan sisältyy?',
    v: 'Kaikki, mitä yhden järjestelmän käyttöönotto vaatii: ennakkoarvio, arviointi riskeineen ja toimenpiteineen, tarvittaessa tasapainotesti ja siirtovaikutusten arviointi sekä kirjaukset tietosuojaselosteeseen ja selosteeseen käsittelytoimista. Erikseen hinnoitellaan vain perusoikeusvaikutusten arviointi (FRIA), jota tarvitsevat tietyt suuririskisen tekoälyn käyttöönottajat.',
  },
  {
    k: 'Entä jos vaikutustenarviointia ei tarvita?',
    v: `Silloin maksatte vain ennakkoarvion, ${eur(HINNAT.ennakkoarvio.pieni)}, ja saatte kirjallisen perustelun. Jos arviointi tarvitaan, ennakkoarvion hinta vähennetään sen hinnasta.`,
  },
  {
    k: 'Miksi järjestelmä vaikuttaa hintaan?',
    v: 'Koska arvioitavaa on eri määrä. Erillinen tekoälytyökalu on suppeampi kuin koko toimisto-ohjelmisto, ja tekoäly, joka pääsee käyttäjän sähköposteihin ja tiedostoihin, laajentaa arviota. Arkaluonteiset tiedot laajentavat sitä eniten.',
  },
  {
    k: 'Sisältyykö hintoihin arvonlisävero?',
    v: 'Ei. Hinnat ovat alv 0 %, ja niihin lisätään arvonlisävero 25,5 %.',
  },
  {
    k: 'Entä jos tarvitsemme laajemman kokonaisuuden?',
    v: 'Useampi järjestelmä samassa arvioinnissa ja laajemmat kokonaisuudet hinnoitellaan kiinteällä tarjouksella. Kerro tilanteesi tarjouspyynnöllä.',
  },
];

const alin = (rivit: { pieni: number | null; keski: number }[]) => Math.min(...rivit.map((r) => r.pieni ?? r.keski));
const OPAS = [
  {
    nro: '1',
    otsikko: 'Perusasiakirjat kuntoon',
    teksti: 'GAP-analyysi, tietosuojaselosteet ja seloste käsittelytoimista.',
    hinta: `alkaen ${eur(alin(PERUS.map((a) => HINNAT[a])))}`,
    ankkuri: '#perusasiakirjat',
  },
  {
    nro: '2',
    otsikko: 'Uusi järjestelmä tai tekoäly',
    teksti: 'Vaikutustenarviointi, jossa kaikki tarvittava on mukana.',
    hinta: `alkaen ${eur(JARJESTELMAT.rajattu.pieni)}`,
    ankkuri: '#jarjestelmat',
  },
  {
    nro: '3',
    otsikko: 'Pysyy kunnossa',
    teksti: 'Vuosipäivitys tai tietosuojavastaava palveluna.',
    hinta: `alkaen ${eur(JATKUVAT.kunnossa.pieni)}/kk`,
    ankkuri: '#jatkuvat',
  },
];
---

<Perus
  otsikko={`Tietosuojapalvelujen hinnasto – kaikki hinnat | ${SIVUSTO.nimi}`}
  kuvaus="Mitä tietosuojaseloste, seloste käsittelytoimista tai vaikutustenarviointi maksaa? Kaikki hinnat ja toimitusajat näkyvillä. Valitse koko, näet hinnan."
  murut={[{ nimi: 'Hinnasto', polku: '/hinnasto' }]}
  schema={[usein(KYSYMYKSET)]}
>
  <section class="osio hinnasto-alku">
    <div class="kehys">
      <div class="osio__otsikko">
        <p class="nostin">Hinnasto</p>
        <h1>Tietosuojapalvelujen hinnasto: kaikki hinnat näkyvillä</h1>
        <p class="johdatus">
          Hinta riippuu kahdesta asiasta: organisaation koosta ja siitä, mitä tarvitsette. Kaikilla palveluilla on
          kiinteä hinta ja luvattu toimitusaika.
        </p>
      </div>
      <Aloitus />
      <ol class="opas">
        {
          OPAS.map((o) => (
            <li>
              <a class="opas__kortti" href={o.ankkuri}>
                <span class="opas__nro" aria-hidden="true">{o.nro}</span>
                <span class="opas__otsikko">{o.otsikko}</span>
                <span class="opas__teksti">{o.teksti}</span>
                <span class="opas__hinta">{o.hinta}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="osio osio--valkoinen hinnasto" id="perusasiakirjat">
    <div class="kehys">
      <div class="osio__otsikko">
        <h2>1. Perusasiakirjat organisaation koon mukaan</h2>
        <p class="johdatus">Nämä tarvitsee jokainen, joka käsittelee asiakkaiden, työntekijöiden tai työnhakijoiden tietoja.</p>
      </div>

      <!-- Ilman JavaScriptiä valitsin pysyy piilossa ja kaikki kolme hintasaraketta näkyvät. -->
      <fieldset class="kokovalitsin" data-kokovalitsin hidden>
        <legend>Organisaation koko</legend>
        <div class="kokovalitsin__valinnat">
          {
            KOOT.map((k, i) => (
              <div>
                <input type="radio" name="koko" id={`koko-${k.id}`} value={k.id} checked={i === 0} />
                <label for={`koko-${k.id}`}>
                  {k.nimi}
                  <small>{k.lyhyt}</small>
                </label>
              </div>
            ))
          }
        </div>
      </fieldset>

      <div class="taulu" role="region" aria-label="Perusasiakirjojen hinnat" tabindex="0">
        <table class="taulukko">
          <caption>Perusasiakirjat, hinnat alv 0 %</caption>
          <thead>
            <tr>
              <th scope="col">Palvelu</th>
              {KOOT.map((k) => <th scope="col" class={`h k-${k.id}`}>{k.nimi}</th>)}
              <th scope="col" class="sarake-toimitus">Toimitus</th>
              <th scope="col" class="sarake-toimitus"><span class="pieni">Toiminto</span></th>
            </tr>
          </thead>
          <tbody>
            {
              PERUS.map((a) => {
                const p = HINNAT[a];
                return (
                  <tr>
                    <th scope="row">
                      <a href={p.polku}>{p.nimi}</a>
                      <span>{p.lyhyt}</span>
                      <span class="vain-kapea">Toimitus {p.toimitus} · <a href={`/yhteystiedot?palvelu=${p.polku.slice(1)}`}>Tilaa</a></span>
                    </th>
                    {KOOT.map((k) => (
                      <td class={`h k-${k.id}`}>{p[k.id] === null ? '–' : eur(p[k.id] as number)}</td>
                    ))}
                    <td class="sarake-toimitus">{p.toimitus}</td>
                    <td class="sarake-toimitus">
                      <a class="painike painike--pieni painike--toinen" href={`/yhteystiedot?palvelu=${p.polku.slice(1)}`}>
                        Tilaa
                      </a>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <div class="paketti" id="paketti">
        <div>
          <span class="merkinta">Säästät noin 20 %</span>
          <h3>{PAKETTI.nimi} -paketti</h3>
          <p>
            GAP-analyysi, tietosuojaselosteet ja seloste käsittelytoimista yhdessä. Suosituin valinta. Jos olette jo
            teettäneet GAP-analyysin, sen hinta vähennetään paketista.
          </p>
          <div class="painikkeet">
            <a class="painike" href="/yhteystiedot?palvelu=paketti">Tilaa paketti</a>
            <a class="painike painike--toinen" href="/yhteystiedot">Kysy lisää</a>
          </div>
        </div>
        <div class="taulu">
          <table class="taulukko">
            <caption>Paketin hinta koon mukaan, alv 0 %</caption>
            <thead>
              <tr>
                <th scope="col"><span class="pieni">Hinta</span></th>
                {KOOT.map((k) => <th scope="col" class={`h k-${k.id}`}>{k.nimi}</th>)}
              </tr>
            </thead>
            <tbody>
              <tr class="rivi--erikseen">
                <th scope="row">Erikseen</th>
                {KOOT.map((k) => <td class={`h k-${k.id}`}>{eur(pakettiErikseen(k.id))}</td>)}
              </tr>
              <tr>
                <th scope="row">Pakettina</th>
                {KOOT.map((k) => <td class={`h k-${k.id}`}><strong>{eur(PAKETTI[k.id])}</strong></td>)}
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <h3 class="koot-otsikko">Mitä koot tarkoittavat?</h3>
      <dl class="tiedot tiedot--koot">
        {
          KOOT.map((k) => (
            <div>
              <dt>{k.nimi}</dt>
              <dd>{k.kuvaus}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="osio hinnasto" id="jarjestelmat">
    <div class="kehys">
      <div class="osio__otsikko">
        <h2>2. Uusi järjestelmä tai tekoäly: yksi hinta, kaikki mukana</h2>
        <p class="johdatus">
          Vaikutustenarviointi hinnoitellaan järjestelmää kohden. Hinta kattaa kaiken, mitä käyttöönotto tietosuojan
          kannalta vaatii, joten lisälaskuja ei tule.
        </p>
      </div>
      <div class="jarjestelmat">
        <div class="sisaltyy">
          <h3>Hintaan sisältyy</h3>
          <ul class="tarkistukset">
            {
              ARVIOINNIN_SISALTO.map((s) => (
                <li>
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <span>{s.charAt(0).toUpperCase() + s.slice(1)}</span>
                </li>
              ))
            }
          </ul>
          <p class="pieni">
            Jos ennakkoarvio osoittaa, ettei arviointia tarvita, maksatte vain sen: {eur(HINNAT.ennakkoarvio.pieni)}.
          </p>
        </div>
        <div class="taulu" role="region" aria-label="Vaikutustenarvioinnin hinnat järjestelmittäin" tabindex="0">
          <table class="taulukko">
            <caption>Vaikutustenarviointi järjestelmää kohden, alv 0 %, toimitus {HINNAT.vaikutustenarviointi.toimitus}</caption>
            <thead>
              <tr>
                <th scope="col">Järjestelmä</th>
                {KOOT.map((k) => <th scope="col" class={`h k-${k.id}`}>{k.nimi}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                JARJESTELMIEN_JARJESTYS.map((a) => {
                  const j = JARJESTELMAT[a];
                  return (
                    <tr>
                      <th scope="row">
                        {j.nimi}
                        {/* Yhdellä rivillä, jotta pilkkujen eteen ei tule välilyöntiä. */}
                        <span>{j.artikkelit.map((r, i) => <>{i > 0 && ', '}<a href={r.polku}>{r.nimi}</a></>)}{j.artikkelit.length > 0 && j.esimerkit ? ', ' : ''}{j.esimerkit}</span>
                      </th>
                      {KOOT.map((k) => (
                        <td class={`h k-${k.id}`}>{eur(j[k.id])}</td>
                      ))}
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </div>
      <p class="pieni">
        Useampi järjestelmä samassa arvioinnissa hinnoitellaan kiinteällä tarjouksella. Lue lisää
        <a href={HINNAT.vaikutustenarviointi.polku}>vaikutustenarvioinnista</a>.
      </p>
    </div>
  </section>

  <section class="osio osio--valkoinen" id="lisaarvioinnit">
    <div class="kehys">
      <div class="osio__otsikko">
        <h2>Erilliset arvioinnit kiinteään hintaan</h2>
        <p class="johdatus">
          Kun ette tarvitse koko vaikutustenarviointia, voitte tilata yksittäisen arvioinnin. Ennakkoarvio, tasapainotesti
          ja siirtovaikutusten arviointi maksavat saman organisaation koosta riippumatta.
        </p>
      </div>
      <div class="ruudukko ruudukko--4">
        {
          ERILLISET.map((p) => (
            <article class="kortti kortti--hinta">
              <h3><a href={p.polku}>{p.nimi}</a></h3>
              <p>{p.lyhyt}</p>
              <div class="kortti__ala">
                {kiintea(p) ? (
                  <span class="kortti__hinta">{eur(p.keski)}</span>
                ) : (
                  <ul class="rivit">
                    {KOOT.map((k) => (
                      <li>
                        <span>{k.nimi}</span>
                        <span>{eur(p[k.id] as number)}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <span class="pieni">
                  {p.yksikko}, toimitus {p.toimitus}
                </span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="osio hinnasto" id="jatkuvat">
    <div class="kehys">
      <div class="osio__otsikko">
        <h2>3. Jatkuvat palvelut</h2>
        <p class="johdatus">Vapaaehtoisia. Kertaostos riittää, jos haluat vain asiakirjat kuntoon.</p>
      </div>
      <div class="taulu">
        <table class="taulukko">
          <caption>Kuukausihinnat, alv 0 %</caption>
          <thead>
            <tr>
              <th scope="col">Palvelu</th>
              {KOOT.map((k) => <th scope="col" class={`h k-${k.id}`}>{k.nimi}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">{JATKUVAT.kunnossa.nimi}<span>{JATKUVAT.kunnossa.lyhyt}</span></th>
              {KOOT.map((k) => <td class={`h k-${k.id}`}>{eur(JATKUVAT.kunnossa[k.id])}/kk</td>)}
            </tr>
            <tr>
              <th scope="row"><a href={JATKUVAT.vastaava.polku}>{JATKUVAT.vastaava.nimi}</a><span>{JATKUVAT.vastaava.lyhyt}</span></th>
              {KOOT.map((k) => <td class={`h k-${k.id}`}>{eur(JATKUVAT.vastaava[k.id])}/kk</td>)}
            </tr>
          </tbody>
        </table>
      </div>
      <p class="pieni">
        Hinnat alv 0 % (alv 25,5 % lisätään). Tilauksiin sovelletaan <a href="/toimitusehdot">toimitusehtoja</a> ja
        <a href="/kasittelysopimus">käsittelysopimusta</a>.
      </p>
    </div>
  </section>

  <section class="osio osio--valkoinen" id="kokonaisuudet">
    <div class="kehys">
      <div class="osio__otsikko">
        <h2>Esimerkkejä: mitä kokonaisuus maksaa?</h2>
        <p class="johdatus">Lopullinen sisältö riippuu käsittelyistänne ja toimittajien siirtoperusteista.</p>
      </div>
      <div class="ruudukko">
        {
          KOKONAISUUDET.map((k) => (
            <article class="kortti">
              <h3>{k.otsikko}</h3>
              <p class="pieni">{k.kuvaus}</p>
              <ul class="rivit">
                {k.rivit.map((r) => (
                  <li>
                    <span>{r.nimi}</span>
                    <span>{eur(r.hinta)}</span>
                  </li>
                ))}
              </ul>
              <p class="asiakirja__summa">
                <span>Yhteensä, alv 0 %</span>
                <strong>{eur(k.yhteensa)}</strong>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="osio">
    <div class="kehys"><Kysymykset kysymykset={KYSYMYKSET} /></div>
  </section>

  <Loppukehotus />
</Perus>

<script src="../scripts/hinnasto.ts"></script>
