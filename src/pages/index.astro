---
// Etusivulla on vain neljä osiota, koska sen ainoa tehtävä on ohjata lukija yhteydenottoon tai oman
// tilanteensa palveluun. Palvelulista, kysymykset ja perustelut ovat omilla sivuillaan.
import Perus from '../layouts/Perus.astro';
import Ikoni, { type IkoninNimi } from '../components/Ikoni.astro';
import Loppukehotus from '../components/Loppukehotus.astro';
import Prosessi from '../components/Prosessi.astro';
import type { ComponentProps } from 'astro/types';
import { SIVUSTO } from '../../site.config.mjs';
import { HINNAT, PAKETTI, eur } from '../data/hinnat';
import { organisaatio, verkkosivusto } from '../data/schema';

// Kolme yleisintä syytä ottaa yhteyttä. Jokainen johtaa yhteen palveluun, joten lukijan ei tarvitse
// osata palvelujen nimiä.
const TILANTEET: { ikoni: IkoninNimi; tilanne: string; ratkaisu: string; palvelu: string; hinta: number; polku: string }[] = [
  {
    ikoni: 'seloste',
    tilanne: 'Asiakas tai tarjouspyyntö kysyy tietosuojaselostetta',
    ratkaisu: 'GAP-analyysi, tietosuojaselosteet ja seloste käsittelytoimista kerralla.',
    palvelu: `${PAKETTI.nimi} -paketti`,
    hinta: PAKETTI.pieni,
    polku: '/hinnasto#paketti',
  },
  {
    ikoni: 'kilpi',
    tilanne: 'Otamme käyttöön uuden järjestelmän tai tekoälyn',
    ratkaisu: 'Arvioimme riskit ennen käyttöönottoa ja kerromme, mitä pitää tehdä.',
    palvelu: HINNAT.vaikutustenarviointi.nimi,
    hinta: HINNAT.vaikutustenarviointi.pieni,
    polku: HINNAT.vaikutustenarviointi.polku,
  },
  {
    ikoni: 'suurennus',
    tilanne: 'Emme tiedä, missä tietosuojan kanssa mennään',
    ratkaisu: 'Selvitämme puutteet ja annamme korjauslistan hintoineen.',
    palvelu: 'GAP-analyysi',
    hinta: HINNAT.tarkastus.pieni,
    polku: HINNAT.tarkastus.polku,
  },
];

// Ensimmäinen vaihe ei vaadi, että asiakas tietää tarpeensa: sen selvittäminen on meidän työtämme.
const VAIHEET: ComponentProps<typeof Prosessi>['vaiheet'] = [
  {
    kuka: 'Te',
    otsikko: 'Ota yhteyttä',
    teksti:
      'Sinun ei tarvitse tietää, mitä organisaationne tarvitsee. Kerro, mitä teette, niin selvitämme sen ja vahvistamme kiinteän hinnan kirjallisena.',
  },
  {
    kuka: 'Te',
    otsikko: 'Vastaatte alkukartoitukseen',
    teksti: 'Valmiit kysymykset arkikielellä siitä, miten toimitte. Tietosuojaosaamista ei tarvita, ja neuvomme tarvittaessa.',
  },
  {
    kuka: 'Complia',
    otsikko: 'Teemme asiakirjat',
    teksti:
      'Haastattelemme tarvittaessa oikeat ihmiset etänä, tunnistamme lain vaatimukset ja kirjoitamme asiakirjat 3–10 arkipäivässä.',
  },
  {
    kuka: 'Yhdessä',
    otsikko: 'Käymme läpi ja hyväksytte',
    teksti: 'Korjaamme luonnokset kanssanne. Saatte valmiit asiakirjat ja listan tarvittavista toimista. Lasku vasta, kun hyväksytte.',
  },
];

const KANSIO: { ikoni: IkoninNimi; nimi: string }[] = [
  { ikoni: 'seloste', nimi: 'Tietosuojaselosteet' },
  { ikoni: 'lista', nimi: 'Seloste käsittelytoimista' },
  { ikoni: 'kilpi', nimi: 'Vaikutustenarviointi' },
  { ikoni: 'kaavio', nimi: 'Toimenpidelista' },
];
---

<Perus
  otsikko={`${SIVUSTO.slogan} | ${SIVUSTO.nimi}`}
  kuvaus="GDPR kuntoon valmiilla asiakirjoilla: tietosuojaselosteet, selosteet käsittelytoimista ja vaikutustenarvioinnit yrityksille ja kunnille. Julkiset hinnat."
  schema={[organisaatio(), verkkosivusto()]}
>
  <section class="paa">
    <div class="paa__paneeli">
      <div class="kehys paa__ruudukko">
        <div class="paa__teksti">
          <p class="paa__nostin">Yrityksille ja kunnille</p>
          <h1>Tietosuoja ja GDPR kuntoon – <span class="korostus">valmiina ja kiinteällä hinnalla</span></h1>
          <p class="paa__alaotsikko">Te vastaatte kysymyksiin. Me teemme asiakirjat valmiiksi.</p>
          <div class="painikkeet paa__toiminnot">
            <a class="painike painike--kulta painike--iso" href="/yhteystiedot">
              Ota yhteyttä <Ikoni nimi="nuoli" class="ikoni ikoni--nuoli" />
            </a>
            <a class="paa__linkki" href="/pikatesti">tai tee 2 minuutin pikatesti</a>
          </div>
          <ul class="paa__lupaukset">
            <li><Ikoni nimi="tarkistus" />Kiinteä hinta etukäteen</li>
            <li><Ikoni nimi="tarkistus" />Valmiina 3–10 arkipäivässä</li>
            <li><Ikoni nimi="tarkistus" />Lasku vasta, kun hyväksytte</li>
          </ul>
        </div>
        <div class="paa__kuva" aria-hidden="true">
          <div class="asiakirja kansio">
            <p class="asiakirja__ots">Tietosuojakansio</p>
            <p class="asiakirja__kuvaus">Asiakirjat valmiina ja hyväksyttyinä</p>
            <ul class="kansio__rivit">
              {
                KANSIO.map((r) => (
                  <li>
                    <span class="kansio__ikoni">
                      <Ikoni nimi={r.ikoni} />
                    </span>
                    <span>{r.nimi}</span>
                    <span class="kansio__tila">
                      <Ikoni nimi="tarkistus" />
                      Valmis
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="osio">
    <div class="kehys">
      <div class="osio__otsikko osio__otsikko--keski">
        <h2>Mikä tilanteenne on?</h2>
        <p class="johdatus">Valitse lähin. Näet, mitä teemme ja mitä se maksaa.</p>
      </div>
      <ul class="tilanteet">
        {
          TILANTEET.map((t) => (
            <li>
              <a class="tilanne" href={t.polku}>
                <span class="tilanne__ikoni">
                  <Ikoni nimi={t.ikoni} />
                </span>
                <span class="tilanne__otsikko">{t.tilanne}</span>
                <span class="tilanne__ratkaisu">{t.ratkaisu}</span>
                <span class="tilanne__ala">
                  <span>
                    <span class="tilanne__palvelu">{t.palvelu}</span>
                    <span class="tilanne__hinta">alkaen {eur(t.hinta)}</span>
                  </span>
                  <Ikoni nimi="nuoli" class="ikoni tilanne__nuoli" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="kuntalinkki">
        <Ikoni nimi="kunta" /> Edustatko kuntaa? <a href="/kunnat">Katso kuntien palvelut pienhankintana</a>
      </p>
    </div>
  </section>

  <section class="osio osio--valkoinen">
    <div class="kehys">
      <div class="osio__otsikko osio__otsikko--keski">
        <h2>Näin se toimii</h2>
        <p class="johdatus">
          Teidän osuutenne on vastata kysymyksiin. Selvittäminen, lain tulkinta ja kirjoittaminen on meidän työtämme.
        </p>
      </div>
      <Prosessi vaiheet={VAIHEET} />
      <p class="luottamus">
        Jokainen asiakirja tarkistetaan ennen luovutusta. <a href="/meista">Asiantuntijamme</a> ovat suorittaneet FCG:n
        tietosuojavastaavan koulutusohjelman.
      </p>
    </div>
  </section>

  <Loppukehotus />
</Perus>
